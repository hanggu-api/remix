{
  "name": "proservicos-cloudflare-backend",
  "version": "1.0.0",
  "description": "Backend unificado no Cloudflare Workers e D1 para os Apps Flutter Cliente e Prestador",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute proservicos-d1 --local --file=./schema.sql",
    "db:deploy": "wrangler d1 execute proservicos-d1 --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.6"
  }
}
